---
import Subtitle from "@src/components/atoms/Subtitle/Subtitle.astro";
const discordData  = {
  title: "Follow me on Instagram",
  content: "Follow me so you don't miss out on important explanations and news about the world of AI, hackers, and penetration testing.",
  link: "https://www.instagram.com/x_mr.fox_x",
  image: "../img/icons/DiscordLogo.svg",
};

---

<div class="card-social__container">
<Subtitle content="Follow me on Instagram" />
  <p class="card-social__content">
    Follow me so you don't miss out on important explanations and news about the world of AI, hackers, and penetration testing.
  </p>
  <a class="card-social__link" href="https://www.instagram.com/x_mr.fox_x" target="_blank" rel="noreferrer noopener nofollow">
    Follow Me <iconify-icon
      icon="quill:link-out"
      width="15"
      height="15"
      style="color: aqua"></iconify-icon></a
  >
  <img
    class="card-social__image"
    src="../img/icons/DiscordLogo.svg"
    alt="Discord logo"
  />
</div>
