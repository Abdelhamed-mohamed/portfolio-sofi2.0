---
import Subtitle from "@src/components/atoms/Subtitle/Subtitle.astro";
import Button from "@atoms/Button/Button.astro";
import SocialCardImage from "@src/components/atoms/SocialCardImage/SocialCardImage.astro";
---

<div class="card-social__container tiktok__card">
  <Subtitle content="My Latest TikTok video" />
  <p class="card-social__content">I love sharing the knowledge I've gained over the years on my TikTok account. Check out my latest video and join me on this learning journey!</p>

  <div class="tiktokThumbnail"></div>
  
  <!-- تم تعديل رابط الحساب هنا -->
  <a href="https://www.tiktok.com/@Medo.hackerz" target="_blank" rel="noopener noreferrer" class="button-link">
    <Button type="button" content="Watch" extraClass="tiktok__button tiktok__button__play"/>
  </a>
  
  <SocialCardImage image="/img/icons/youtube.svg" altDesc="Youtube logo" />
</div>

<style lang="scss" is:inline>
  .card-social__container {
    position: relative;
  }

  .tiktokThumbnail {
    background-size: cover;
    width: 100%;
    height: 116%;
    position: absolute;
    z-index: -1;
    top: -17%;
    left: 0;
    mix-blend-mode: multiply;
    filter: opacity(0.5) blur(4px);
    overflow: hidden;
  }

  .tiktok__button {
    max-width: 10rem;
  }

  .tiktok__card:hover .tiktok__button__play {
    filter: opacity(1);
  }

  .button-link {
    text-decoration: none;
    display: inline-block;
  }
</style>
